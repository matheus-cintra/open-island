// open-island-managed
import type { Plugin } from "@opencode-ai/plugin";

const DAEMON = __OPEN_ISLANDD_PATH__;
const EVENTS = new Set([
  "session.created",
  "session.deleted",
  "session.status",
  "session.idle",
  "session.updated",
  "tool.execute.before",
  "tool.execute.after",
  "permission.asked",
  "question.asked",
  "question.replied",
]);

const PROMPT_EVENT = "open-island.prompt";
const TRACKED_MESSAGES = 64;


function record(value: unknown): Record<string, unknown> {
  return typeof value === "object" && value !== null
    ? (value as Record<string, unknown>)
    : {};
}

function remember(seen: Set<string>, id: string): void {
  seen.add(id);
  if (seen.size > TRACKED_MESSAGES) seen.delete(seen.values().next().value as string);
}

function userPrompt(type: string, properties: Record<string, unknown>, userMessages: Set<string>, promptedMessages: Set<string>): unknown {
  if (type === "message.updated") {
    const info = record(properties.info);
    if (info.role === "user" && typeof info.id === "string") remember(userMessages, info.id);
    return null;
  }
  if (type !== "message.part.updated") return null;
  const part = record(properties.part);
  const messageID = typeof part.messageID === "string" ? part.messageID : "";
  const text = typeof part.text === "string" ? part.text : "";
  if (part.type !== "text" || text === "" || !userMessages.has(messageID)) return null;
  if (promptedMessages.has(messageID)) return null;
  remember(promptedMessages, messageID);
  return {
    type: PROMPT_EVENT,
    properties: { sessionID: properties.sessionID ?? part.sessionID, text },
  };
}

type PermissionReply = "once" | "always" | "reject";

function permissionReply(output: string, exitCode: number): PermissionReply | null {
  if (exitCode !== 0 || output.trim() === "") return null;
  try {
    const value = record(JSON.parse(output));
    if (value.reply === "once" || value.reply === "always" || value.reply === "reject") {
      return value.reply;
    }
    return null;
  } catch {
    return null;
  }
}

function questionAnswers(output: string, exitCode: number): string[][] | null {
  if (exitCode !== 0 || output.trim() === "") return null;
  try {
    const answers = record(JSON.parse(output)).answers;
    if (!Array.isArray(answers) || answers.length === 0) return null;
    return answers.map((row) =>
      Array.isArray(row) ? row.filter((label) => typeof label === "string") : [],
    );
  } catch {
    return null;
  }
}

function requestID(properties: Record<string, unknown>): string {
  if (typeof properties.id === "string") return properties.id;
  if (typeof properties.requestID === "string") return properties.requestID;
  return "";
}

export const OpenIslandPlugin: Plugin = async ({ client, serverUrl, directory }) => {
  const userMessages = new Set<string>();
  const promptedMessages = new Set<string>();
  type Metadata = { id: string; parent_id: string | null; title: string | null };
  const cache = new Map<string, Metadata>();
  const pending = new Map<string, Promise<Metadata | null>>();
  function metadata(info: Record<string, unknown>): Metadata | null {
    if (typeof info.id !== "string" || !info.id) return null;
    const result = {
      id: info.id,
      parent_id: typeof info.parentID === "string" ? info.parentID : null,
      title: typeof info.title === "string" ? info.title : null,
    };
    cache.set(result.id, result);
    return result;
  }
  async function lookup(id: string): Promise<Metadata | null> {
    if (cache.has(id)) return cache.get(id)!;
    if (pending.has(id)) return pending.get(id)!;
    const request = (async () => {
      try {
        const response = await client.session.get(
          { path: { id }, query: { directory }, signal: AbortSignal.timeout(1000) },
        );
        const info = record(response.data);
        return info.id === id ? metadata(info) : null;
      } catch { return null; }
      finally { pending.delete(id); }
    })();
    pending.set(id, request);
    return request;
  }
  async function lineage(id: string): Promise<Metadata[]> {
    const result: Metadata[] = [];
    const seen = new Set<string>();
    while (id && !seen.has(id) && seen.size < 32) {
      seen.add(id);
      const info = await lookup(id);
      if (!info) break;
      result.push(info);
      id = info.parent_id ?? "";
    }
    return result;
  }
  return {
  async event({ event }) {
    const prompt = userPrompt(event.type, record(event.properties), userMessages, promptedMessages);
    if (prompt === null && !EVENTS.has(event.type)) return;
    const outgoing = record(prompt ?? event);
    const properties = record(outgoing.properties);
    const info = record(properties.info);
    const sessionID = typeof properties.sessionID === "string" ? properties.sessionID
      : typeof info.id === "string" ? info.id : "";
    if (event.type.startsWith("session.") && typeof info.id === "string") metadata(info);
    // Bound metadata work for the whole chain, including broken/unreachable ancestors.
    let timer: ReturnType<typeof setTimeout> | undefined;
    const session_metadata = await Promise.race([
      lineage(sessionID),
      new Promise<Metadata[]>((resolve) => { timer = setTimeout(() => resolve([]), 1200); }),
    ]).finally(() => clearTimeout(timer));
    const child = Bun.spawn(
      [DAEMON, "hook", "--agent", "opencode", "--managed-by", "open-island"],
      { stdin: "pipe", stdout: "pipe", stderr: "pipe" },
    );
    child.stdin.write(
      JSON.stringify({ ...outgoing, session_metadata, cwd: directory, pid: process.pid }),
    );
    child.stdin.end();
    const output = await new Response(child.stdout).text();
    const exitCode = await child.exited;

    if (event.type === "question.asked") {
      const answers = questionAnswers(output, exitCode);
      const id = requestID(properties);
      if (answers === null || id === "") return;
      await fetch(new URL(`/question/${encodeURIComponent(id)}/reply`, serverUrl), {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ answers }),
      });
      return;
    }

    if (event.type !== "permission.asked") return;
    const id = requestID(properties);
    if (sessionID === "" || id === "") return;
    const reply = permissionReply(output, exitCode);
    if (reply === null) return;
    const modern = client as unknown as {
      permission?: { reply(input: { sessionID: string; requestID: string; reply: PermissionReply }): Promise<unknown> };
    };
    if (modern.permission) {
      await modern.permission.reply({ sessionID, requestID: id, reply });
    } else {
      await client.postSessionIdPermissionsPermissionId({
        path: { id: sessionID, permissionID: id },
        query: { directory },
        body: { response: reply },
      });
    }
  },
  };
};

export default OpenIslandPlugin;
// end-open-island-managed

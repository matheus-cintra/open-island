{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Island",
  "version": "0.1.0",
  "identifier": "app.open-island",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prebundle && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Island",
        "visible": false,
        "width": 232,
        "height": 46,
        "minWidth": 100,
        "minHeight": 20,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "Open Island Settings",
        "url": "settings.html",
        "width": 880,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "externalBin": ["binaries/open-islandd"],
    "category": "Utility",
    "shortDescription": "Painel de sessões dos seus agentes de código",
    "longDescription": "Open Island é um painel que fica colado na barra do topo do Hyprland e mostra o que os seus agentes de código estão fazendo agora: sessão, projeto, agente, modelo, terminal e tempo decorrido. Quando um agente pede uma permissão ou faz uma pergunta, a ilha expande e você responde ali mesmo.",
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0",
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0",
          "libgtk-3-0",
          "pipewire-bin",
          "gtk-update-icon-cache"
        ],
        "desktopTemplate": "open-island.desktop.template"
      },
      "rpm": {
        "depends": [
          "gtk-layer-shell",
          "webkit2gtk4.1",
          "libsoup3",
          "gtk3",
          "pipewire-utils",
          "gtk-update-icon-cache"
        ],
        "desktopTemplate": "open-island.desktop.template"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "voice:allow-voice-start",
    "voice:allow-voice-get-state",
    "voice:allow-voice-state",
    "voice:allow-voice-stop",
    "voice:allow-voice-cancel",
    "voice:allow-voice-model-status",
    "voice:allow-voice-select-model",
    "voice:allow-voice-open-microphone-settings",
    "core:default",
    "opener:default",
    "core:window:allow-set-position",
    "core:window:allow-set-size"
  ]
}
